tive="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v12" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v13" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v13" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e43" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v14" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e44" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v14" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v15" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v46" value="SSE delivery (ADR-005)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#555555;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1300" y="610" width="300" height="275" as="geometry"/></mxCell><mxCell id="v47" value="&lt;b&gt;Redis Pub/Sub&lt;/b&gt;&lt;br&gt;customer:{id} · merchant:{id}" style="fontFamily=Helvetica;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1320" y="645" width="260" height="55" as="geometry"/></mxCell><mxCell id="v48" value="&lt;b&gt;Redis Streams&lt;/b&gt; replay ≥5 min&lt;br&gt;(Last-Event-ID)" style="fontFamily=Helvetica;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1320" y="725" width="260" height="55" as="geometry"/></mxCell><mxCell id="v49" value="&lt;b&gt;SSE gateway pods&lt;/b&gt; → clients&lt;br&gt;role filter (Staff: own bookings)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1320" y="810" width="260" height="55" as="geometry"/></mxCell><mxCell id="e50" value="publish" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="v23" target="v47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="append" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="v23" target="v48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="v47" target="v49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e53" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v48" target="v49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v54" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• Outbox row is written in the same DB transaction as the change (no lost / phantom events).&lt;br&gt;• Delivery is at-least-once; consumers dedupe by event id and ignore stale aggregate versions.&lt;br&gt;• Per-key ordering: booking events keyed by booking_id; catalog/review by merchant_id.&lt;br&gt;• Read models are eventually consistent (≤2 s availability, ≤5 min search); writes are always validated against the owner's data.&lt;br&gt;• Kafka outage never blocks bookings or payments: outbox rows accumulate and are published when it recovers (NFR-208)." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#bdb76b;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="790" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>