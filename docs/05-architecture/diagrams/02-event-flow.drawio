<mxfile host="drawio"><diagram id="d1" name="Event flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Event flow — outbox → Kafka topics → consumers (v0.3)" style="fontFamily=Helvetica;text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="900" height="36" as="geometry"/></mxCell><mxCell id="v2" value="Producers (DB transaction writes change + outbox row; relay publishes)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#555555;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="330" height="640" as="geometry"/></mxCell><mxCell id="v3" value="Kafka topics (key)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#555555;arcSize=2;" vertex="1" parent="1"><mxGeometry x="440" y="55" width="300" height="640" as="geometry"/></mxCell><mxCell id="v4" value="Consumers (idempotent: event id + version)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#555555;arcSize=2;" vertex="1" parent="1"><mxGeometry x="830" y="55" width="420" height="705" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Identity&lt;/b&gt; (thin)&lt;br&gt;Keycloak user events + own changes → outbox → relay" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="270" height="60" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Merchant Catalog&lt;/b&gt;&lt;br&gt;outbox → relay" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="270" height="60" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Booking &amp;amp; Payments&lt;/b&gt;&lt;br&gt;outbox → relay" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="270" height="60" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Reviews&lt;/b&gt;&lt;br&gt;outbox → relay" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="270" height="60" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;outbox → relay" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="610" width="270" height="60" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;identity.events&lt;/b&gt; (user id)&lt;br&gt;customer registered/updated/erased, merchant user invited/activated/deactivated" style="fontFamily=Helvetica;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="260" height="70" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;catalog.events&lt;/b&gt; (merchant id)&lt;br&gt;merchant, policy, service, resource (+ staff link), hours, exception (versioned)" style="fontFamily=Helvetica;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="260" height="70" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;booking.events&lt;/b&gt; (booking id)&lt;br&gt;held, provisional, pending, confirmed, rescheduled, moved, cancelled, rejected, completed, no_show, expired" style="fontFamily=Helvetica;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;wallet.events&lt;/b&gt; (wallet id)&lt;br&gt;wallet.updated, ledger tx posted" style="fontFamily=Helvetica;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="410" width="260" height="70" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;review.events&lt;/b&gt; (merchant id)&lt;br&gt;review created/replied, rating changed" style="fontFamily=Helvetica;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="510" width="260" height="70" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;scheduler.events&lt;/b&gt; (booking id)&lt;br&gt;reminder.due" style="fontFamily=Helvetica;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="610" width="260" height="70" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Booking &amp;amp; Payments&lt;/b&gt; — catalog replica (hold/checkout validation, terms snapshot); identity replica (customer names, wallets)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;align=left;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="850" y="85" width="380" height="60" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Availability&lt;/b&gt; — catalog replica + effective allocations → invalidate slot cache" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;align=left;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="850" y="175" width="380" height="60" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Discovery / Search&lt;/b&gt; — merchant + service index, rating" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;align=left;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="850" y="255" width="380" height="60" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Merchant Catalog&lt;/b&gt; — rating summary; merchant users (staff-link validation)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;align=left;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="850" y="335" width="380" height="60" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Reviews&lt;/b&gt; — review eligibility (Completed bookings)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;align=left;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="850" y="415" width="380" height="60" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Scheduler&lt;/b&gt; — create / cancel timers: hold expiry, verify_by, approval deadline, auto-complete, reminders" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;align=left;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="850" y="495" width="380" height="60" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;Notifications&lt;/b&gt; — templates (display snapshot in booking events), contacts, preferences, push devices" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;align=left;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="850" y="585" width="380" height="60" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Realtime fan-out&lt;/b&gt; — republish thin events to recipient topics" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;verticalAlign=middle;align=left;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="850" y="675" width="380" height="60" as="geometry"/></mxCell><mxCell id="e24" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v5" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v6" target="v11"><mxGeometry relative="1" as="geometry"><