urcePoint"/><mxPoint x="1060" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v14" value="&lt;b&gt;Scheduler&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1170" y="55" width="160" height="50" as="geometry"/></mxCell><mxCell id="l15" value="" style="fontFamily=Helvetica;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="105" as="sourcePoint"/><mxPoint x="1250" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v16" value="&lt;b&gt;Notifications&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1360" y="55" width="160" height="50" as="geometry"/></mxCell><mxCell id="l17" value="" style="fontFamily=Helvetica;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="105" as="sourcePoint"/><mxPoint x="1440" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v18" value="&lt;b&gt;Realtime / SSE&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1550" y="55" width="160" height="50" as="geometry"/></mxCell><mxCell id="l19" value="" style="fontFamily=Helvetica;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1630" y="105" as="sourcePoint"/><mxPoint x="1630" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v20" value="1 · Hold a slot  (T1, FR-502, NFR-302 ≤300 ms)" style="fontFamily=Helvetica;rounded=0;html=1;fillColor=#eeeeee;strokeColor=none;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1720" height="24" as="geometry"/></mxCell><mxCell id="l21" value="POST /v1/bookings + Idempotency-Key" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="170" as="sourcePoint"/><mxPoint x="300" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l22" value="JWT ok · rate limit · hold cap" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="200" as="sourcePoint"/><mxPoint x="490" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v23" value="Validate against &lt;b&gt;local catalog replica&lt;/b&gt;: service version, hours ∩ exceptions, min notice / horizon, approval margin, guest rules; pick a free 'any-of' candidate." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#bdb76b;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="360" height="58" as="geometry"/></mxCell><mxCell id="l24" value="TX1 (single local transaction)" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="295" as="sourcePoint"/><mxPoint x="680" y="295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v25" value="INSERT booking(&lt;b&gt;Held&lt;/b&gt;, hold_expires_at = now+10 min) · allocations with expires_at (exclusion constraint on effective ranges → no overlap) · BookingEvent · idempotency record · &lt;b&gt;outbox&lt;/b&gt;(booking.held)" style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#bdb76b;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="690" y="305" width="370" height="88" as="geometry"/></mxCell><mxCell id="l26" value="commit / or overlap → 409 slot_taken (+ alternatives)" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="410" as="sourcePoint"/><mxPoint x="490" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l27" value="201 held · hold_expires_at" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="440" as="sourcePoint"/><mxPoint x="110" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l28" value="poll outbox (≤200 ms)" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#8a3b37;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="480" as="sourcePoint"/><mxPoint x="680" y="480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l29" value="booking.held" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#8a3b37;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="510" as="sourcePoint"/><mxPoint x="1060" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v30" value="update allocation replica, invalidate slot cache (≤2 s)" style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#bdb76b;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1070" y="518" width="170" height="40" as="geometry"/></mxCell><mxCell id="l31" value="booking.held" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#8a3b37;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="580" as="sourcePoint"/><mxPoint x="1250" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v32" value="timer at hold_expires_at" style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#bdb76b;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1260" y="588" width="170" height="40" as="geometry"/></mxCell><mxCell id="v33" value="2 · Checkout  (T3, M1, FR-504/505, NFR-103 atomic, NFR-303 ≤500 ms)" style="fontFamily=Helvetica;rounded=0;html=1;fillColor=#eeeeee;strokeColor=none;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1720" height="24" as="geometry"/></mxCell><mxCell id="l34" value="POST /v1/bookings/{id}/checkout" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="690" as="sourcePoint"/><mxPoint x="300" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l35" value="route" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="720" as="sourcePoint"/><mxPoint x="490" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l36" value="TX2 (single local transaction)" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="750" as="sourcePoint"/><mxPoint x="680" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v37" value="CAS version: &lt;b&gt;Held → Confirmed&lt;/b&gt; if hold not expired · lock customer wallet, check Available ≥ U+F+R · ledger tx &lt;b&gt;M1&lt;/b&gt; (CA→MP, CA→CR) · terms snapshot · clear allocation expiry · BookingEvent · &lt;b&gt;outbox&lt;/b&gt;(booking.confirmed, wallet.updated). Any failure → rollback, hold unchanged" style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#bdb76b;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="690" y="760" width="380" height="100" as="geometry"/></mxCell><mxCell id="l38" value="commit / or 422 insufficient_funds · 409 hold_expired" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="875" as="sourcePoint"/><mxPoint x="490" y="875" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l39" value="200 confirmed" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="905" as="sourcePoint"/><mxPoint x="110" y="905" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l40" value="booking.confirmed" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#8a3b37;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="940" as="sourcePoint"/><mxPoint x="1060" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l41" value="cancel expiry timer · add reminders + auto-complete (end+24 h)" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#8a3b37;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="965" as="sourcePoint"/><mxPoint x="1250" y="965" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l42" value="send confirmation (customer) + new booking (merchant)" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#8a3b37;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="990" as="sourcePoint"/><mxPoint x="1440" y="990" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l43" value="fan-out → customer:{id}, merchant:{id} → SSE booking.created/updated" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#8a3b37;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="1015" as="sourcePoint"/><mxPoint x="1630" y="1015" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v44" value="3 · If checkout never happens  (T6, NFR-107/108)" style="fontFamily=Helvetica;rounded=0;html=1;fillColor=#eeeeee;strokeColor=none;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="1040" width="1720" height="24" as="geometry"/></mxCell><mxCell id="l45" value="POST internal /bookings/{id}/expire at hold_expires_at (idempotent, CAS Held→Expired, outbox)" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#d79b00;fontColor=#9c6500;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="1080" as="sourcePoint"/><mxPoint x="490" y="1080" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v46" value="The expired hold stops counting &lt;b&gt;the instant it passes&lt;/b&gt; (allocation.expires_at is part of the overlap check and of every read) — the Scheduler only materialises the state, so job lag never affects correctness. Same pattern for verify_by (T8), approval deadline (T10) and auto-complete (T17)." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#bdb76b;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="20" y="1120" width="1720" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>