<mxfile host="drawio"><diagram id="s" name="Booking states"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Booking states and transitions (T1–T18)" style="text;html=1;fontFamily=Helvetica;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="600" height="30" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="30" height="30" as="geometry"/></mxCell><mxCell id="held" value="Held&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;10-min hold&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="290" width="150" height="50" as="geometry"/></mxCell><mxCell id="prov" value="Provisional&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;guest, until verify_by&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="150" height="50" as="geometry"/></mxCell><mxCell id="pa" value="PendingApproval&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;paid, until approval_deadline&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="160" height="50" as="geometry"/></mxCell><mxCell id="conf" value="Confirmed" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="290" width="150" height="50" as="geometry"/></mxCell><mxCell id="exp" value="Expired" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="150" height="50" as="geometry"/></mxCell><mxCell id="rej" value="Rejected" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="425" y="470" width="150" height="50" as="geometry"/></mxCell><mxCell id="can" value="Cancelled" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="150" height="50" as="geometry"/></mxCell><mxCell id="comp" value="Completed" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="150" height="50" as="geometry"/></mxCell><mxCell id="ns" value="NoShow" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="150" height="50" as="geometry"/></mxCell><mxCell id="e1" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="start" target="held"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l17" value="T17 completed /&lt;br&gt;auto 24 h after end" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="985" y="290" width="130" height="34" as="geometry"/></mxCell><mxCell id="l1" value="T1 select slot" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="262" width="90" height="34" as="geometry"/></mxCell><mxCell id="l8" value="T8 cutoff passed /&lt;br&gt;cancelled" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="565" y="215" width="120" height="34" as="geometry"/></mxCell><mxCell id="l15c" value="T15 reschedule,&lt;br&gt;T16 move / extend" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="905" y="205" width="130" height="34" as="geometry"/></mxCell><mxCell id="e2" value="T2 staff creates booking" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.8;entryY=0;" edge="1" parent="1" source="start" target="conf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="20"/><mxPoint x="880" y="20"/></Array></mxGeometry></mxCell><mxCell id="e3" value="T3 checkout" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.27;exitY=0;entryX=0.27;entryY=0;" edge="1" parent="1" source="held" target="conf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="60"/><mxPoint x="800" y="60"/></Array></mxGeometry></mxCell><mxCell id="e5" value="T5 guest checkout,&lt;br&gt;verification on" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="held" target="prov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="T4 checkout,&lt;br&gt;needs approval" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="held" target="pa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="T6 hold expires /&lt;br&gt;abandoned" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="held" target="exp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7a" value="T7 verified,&lt;br&gt;needs approval" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prov" target="pa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7b" value="T7 verified" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="prov" target="conf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="125"/><mxPoint x="720" y="302"/></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.25;" edge="1" parent="1" source="prov" target="can"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="150"/><mxPoint x="690" y="482"/></Array></mxGeometry></mxCell><mxCell id="e9" value="T9 approved" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.65;entryX=0;entryY=0.65;" edge="1" parent="1" source="pa" target="conf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="T10 rejected /&lt;br&gt;deadline passed" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1"