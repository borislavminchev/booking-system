ry></mxCell><mxCell id="e18" value="T18 no-show" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;rounded=1;jumpStyle=arc;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="conf" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="leg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue = holds capacity, waiting on a deadline&lt;br&gt;Green = booking is on&lt;br&gt;Grey = terminal, capacity released&lt;br&gt;Tn = transition in booking-lifecycle §3" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="270" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>